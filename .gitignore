# ---------------------------------------------------------------------------
# Analysis outputs
# ---------------------------------------------------------------------------
# Pipeline results. These are regenerated by running the pipeline and are far
# too large to version (rerun/ alone is ~73 MB).
rerun/
results/
outputs/

# Written by examples/run_demo.py. Regenerate with `python examples/run_demo.py`
# rather than committing the figures.
examples/demo_output/
*.npy
*.pkl

# Local, machine-specific run configuration. A template is tracked as
# config.example.json instead.
config.json

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
data/
*.edf
*.hyp
!examples/data/**

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
env/
.python-version

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# Pre-refactor notebooks. They import the removed `functions` package so they no
# longer run, they carry ~3.5 MB of saved outputs, and those outputs embed
# internal file paths. Kept on disk for reference; move them to the analysis
# repository rather than committing them here.
run_pipeline_new.ipynb
run_pipeline_rerun.ipynb
run_pipeline_combined.ipynb

# Superseded by the environment described in pyproject.toml.
environment.yml

# Guide to the pre-refactor notebooks. Superseded by examples/ and
# params/README.md, and its examples contain internal file paths.
NOTEBOOKS_GUIDE.md

# ---------------------------------------------------------------------------
# Tooling / editors / OS
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
